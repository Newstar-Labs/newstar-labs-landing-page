---
import { solutionCards, wideSolution } from '../data/services';

const icons: Record<(typeof solutionCards)[number]['icon'], string> = {
  bolt: '<path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"></path>',
  apps: '<rect x="3" y="3" width="8" height="8" rx="2"></rect><rect x="13" y="13" width="8" height="8" rx="2"></rect><path d="M11 7h4a2 2 0 0 1 2 2v4"></path>',
  network:
    '<circle cx="5" cy="6" r="2.2"></circle><circle cx="19" cy="6" r="2.2"></circle><circle cx="5" cy="18" r="2.2"></circle><circle cx="19" cy="18" r="2.2"></circle><rect x="9.5" y="10.5" width="5" height="3" rx="1"></rect><path d="M6.6 7.6 10.4 11"></path><path d="m17.4 7.6-3.8 3.4"></path><path d="M6.6 16.4 10.4 13"></path><path d="m17.4 16.4-3.8-3.4"></path>',
};

const sidebarItems = [
  { label: 'Resumen', active: true, icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect>' },
  { label: 'Pedidos', active: false, icon: '<path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h10"></path>' },
  { label: 'Tareas', active: false, icon: '<path d="m4 12 3 3 6-7"></path><path d="M13 17h7"></path><path d="M16 7h4"></path>' },
  { label: 'Equipo', active: false, icon: '<circle cx="9" cy="8" r="3.2"></circle><path d="M3.5 19a5.5 5.5 0 0 1 11 0"></path><path d="M17 11h4"></path>' },
  { label: 'Reportes', active: false, icon: '<path d="M5 19V9"></path><path d="M12 19V5"></path><path d="M19 19v-7"></path>' },
];

const records = [
  { label: 'Pedido #1042', status: 'Completado', tone: 'emerald', extra: false },
  { label: 'Cotización · Vega', status: 'En proceso', tone: 'violet', extra: false },
  { label: 'Reposición almacén', status: 'Pendiente', tone: 'neutral', extra: false },
  { label: 'Pedido #1041', status: 'Completado', tone: 'emerald', extra: true },
  { label: 'Seguimiento cliente', status: 'Pendiente', tone: 'neutral', extra: true },
];

const bars = [38, 56, 44, 72, 88, 64, 100];
---

<section id="resolvemos" class="ns-res">
  <div class="ns-res-eyebrow">
    <span class="ns-dot"></span>
    <span class="ns-eyebrow-text">Qué resolvemos</span>
  </div>
  <div class="ns-res-head">
    <h2 class="ns-res-title">Tecnología creada para tu operación real.</h2>
    <p class="ns-res-lead">
      No adaptamos tu empresa a una herramienta genérica. Diseñamos la solución alrededor de cómo funciona tu
      operación.
    </p>
  </div>

  <div class="ns-res-grid">
    {
      solutionCards.map((card) => (
        <div tabindex="0" class={`ns-res-card ns-res-card--${card.accent}`}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={card.accent === 'emerald' ? '#00D992' : '#818CF8'} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[card.icon]} />
          <h3 class="ns-res-cardtitle">{card.title}</h3>
          <p class="ns-res-carddesc">{card.description}</p>
        </div>
      ))
    }

    <div class="ns-res-wide">
      <div class="ns-res-widetext">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#818CF8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 20V10"></path><path d="M10 20V4"></path><path d="M16 20v-7"></path><path d="M22 20H2"></path>
        </svg>
        <h3 class="ns-res-widetitle">{wideSolution.title}</h3>
        <p class="ns-res-widedesc">{wideSolution.description}</p>
        <div class="ns-res-chips">
          {wideSolution.chips.map((chip) => <span>{chip}</span>)}
        </div>
      </div>

      <div class="ns-res-panel">
        <span class="ns-res-panel-label">Visibilidad en tiempo real</span>
        <div class="ns-res-kpis">
          <div class="ns-kpi">
            <div class="ns-kpi-value"><span class="ns-kpi-num ns-kpi-num--emerald">18</span></div>
            <div class="ns-kpi-tag"><span class="ns-kpi-dot ns-kpi-dot--emerald"></span><span>completadas</span></div>
          </div>
          <div class="ns-kpi">
            <div class="ns-kpi-value"><span class="ns-kpi-num">3</span></div>
            <div class="ns-kpi-tag"><span class="ns-kpi-dot ns-kpi-dot--violet"></span><span>pendientes</span></div>
          </div>
          <div class="ns-kpi">
            <div class="ns-kpi-value"><span class="ns-kpi-num ns-kpi-num--muted">0</span></div>
            <div class="ns-kpi-tag"><span class="ns-kpi-dot ns-kpi-dot--neutral"></span><span>vencidas</span></div>
          </div>
        </div>
        <div class="ns-res-spark">
          <svg viewBox="0 0 300 44" width="100%" height="40" fill="none" preserveAspectRatio="none" aria-hidden="true">
            <path d="M2 34 L48 30 L94 32 L140 22 L186 24 L232 14 L296 6" stroke="#818CF8" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" opacity="0.9"></path>
            <circle cx="296" cy="6" r="2.8" fill="#00D992"></circle>
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="ns-res-example">
    <span class="ns-res-example-label">Ejemplo de solución a medida</span>
    <span class="ns-res-example-text">Así podría verse tu operación en un solo lugar.</span>
  </div>

  <div class="ns-mock">
    <div class="ns-mock-titlebar">
      <div class="ns-mock-dots">
        <span></span><span></span><span></span>
      </div>
      <span class="ns-mock-title">Panel de operaciones</span>
    </div>
    <div class="ns-mock-body">
      <div class="ns-mock-side">
        {
          sidebarItems.map((item) => (
            <div class={`ns-mock-navitem ${item.active ? 'is-active' : ''}`}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" set:html={item.icon} />
              <span>{item.label}</span>
            </div>
          ))
        }
      </div>

      <div class="ns-mock-list">
        <div class="ns-mock-tabs">
          <span class="is-active">Resumen</span>
          <span>Pedidos</span>
          <span>Tareas</span>
        </div>
        <div class="ns-mock-daylabel">Hoy · 12 registros</div>
        {
          records.map((record) => (
            <div class={`ns-mock-rec ${record.extra ? 'ns-mock-rec-extra' : ''}`}>
              <span class="ns-mock-rec-label">{record.label}</span>
              <span class={`ns-mock-badge ns-mock-badge--${record.tone}`}>{record.status}</span>
            </div>
          ))
        }
      </div>

      <div class="ns-mock-more">Ver más registros</div>
      <div class="ns-mock-sum">
        <div class="ns-mock-summary-card">
          <div class="ns-mock-summary-head">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#818CF8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3.5 13.8 9 19 10.8 13.8 12.6 12 18 10.2 12.6 5 10.8 10.2 9Z"></path>
            </svg>
            <span>Resumen automático</span>
          </div>
          <p>Esta semana el equipo cerró los pedidos con 1.4 días menos de espera. La reposición de almacén sigue siendo el paso que más se detiene.</p>
          <p class="ns-mock-summary-secondary">Dos cotizaciones llevan más de 48 h sin respuesta del cliente.</p>
        </div>
        <div class="ns-mock-stats">
          <span class="ns-mock-stat ns-mock-stat--emerald">18 tareas completadas</span>
          <span>·</span>
          <span>3 pendientes</span>
          <span>·</span>
          <span>0 vencidas</span>
        </div>
        <div class="ns-mock-bars">
          {bars.map((h, i) => <div class="ns-mock-bar" style={`height:${h}%`} data-index={i}></div>)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ns-res {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 104px 24px;
  }

  .ns-res-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ns-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-emerald);
  }

  .ns-eyebrow-text {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-text-primary-rgb), 0.5);
  }

  .ns-res-head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    align-items: end;
    margin-top: 20px;
  }

  .ns-res-title {
    font-family: var(--font-display);
    font-size: clamp(29px, 4.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
    text-wrap: pretty;
  }

  .ns-res-lead {
    margin: 0;
    color: rgba(var(--color-text-primary-rgb), 0.6);
    font-size: 16px;
    line-height: 1.65;
    max-width: 30rem;
  }

  .ns-res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 16px;
    margin-top: 48px;
  }

  .ns-res-card {
    background: rgba(var(--color-text-primary-rgb), 0.025);
    box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.08);
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    padding: 24px;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    column-gap: 16px;
    align-items: start;
    transition: background 0.42s ease-out, box-shadow 0.42s ease-out;
  }

  .ns-res-card--emerald:hover,
  .ns-res-card--emerald:focus-visible {
    background: rgba(var(--color-emerald-rgb), 0.05);
    box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.12), 0 0 0 1px rgba(var(--color-emerald-rgb), 0.22);
  }

  .ns-res-card--violet:hover,
  .ns-res-card--violet:focus-visible {
    background: rgba(var(--color-violet-rgb), 0.05);
    box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.12), 0 0 0 1px rgba(var(--color-violet-rgb), 0.22);
  }

  .ns-res-card svg {
    flex: none;
    margin-top: 2px;
  }

  .ns-res-cardtitle {
    grid-column: 2;
    margin: 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    min-height: 44px;
  }

  .ns-res-carddesc {
    grid-column: 2;
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(var(--color-text-primary-rgb), 0.55);
  }

  .ns-res-wide {
    grid-column: 1 / -1;
    background: rgba(var(--color-text-primary-rgb), 0.025);
    box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.08);
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    align-items: center;
  }

  .ns-res-widetext {
    flex: 1 1 320px;
    min-width: 0;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    column-gap: 16px;
    align-items: start;
  }

  .ns-res-widetitle {
    grid-column: 2;
    margin: 0;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .ns-res-widedesc {
    grid-column: 2;
    margin: 10px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: rgba(var(--color-text-primary-rgb), 0.55);
    max-width: 26rem;
  }

  .ns-res-chips {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .ns-res-chips span {
    font-size: 12px;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid rgba(var(--color-violet-rgb), 0.28);
    background: rgba(var(--color-violet-rgb), 0.08);
    color: var(--color-violet);
  }

  .ns-res-panel {
    flex: 0 1 320px;
    min-width: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ns-res-panel-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-violet);
    opacity: 0.85;
  }

  .ns-res-kpis {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: flex-start;
    gap: 14px;
  }

  .ns-kpi {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ns-kpi-num {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  .ns-kpi-num--emerald {
    color: var(--color-emerald);
  }

  .ns-kpi-num--muted {
    color: rgba(var(--color-text-primary-rgb), 0.55);
  }

  .ns-kpi-tag {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: rgba(var(--color-text-primary-rgb), 0.45);
  }

  .ns-kpi-dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: rgba(var(--color-text-primary-rgb), 0.22);
  }

  .ns-kpi-dot--emerald {
    background: var(--color-emerald);
  }

  .ns-kpi-dot--violet {
    background: var(--color-violet);
  }

  .ns-res-spark {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
  }

  .ns-res-example {
    margin-top: 72px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 16px;
  }

  .ns-res-example-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-text-primary-rgb), 0.42);
  }

  .ns-res-example-text {
    font-size: 14px;
    color: rgba(var(--color-text-primary-rgb), 0.5);
  }

  .ns-mock {
    margin-top: 20px;
    border-radius: 22px;
    border: 1px solid rgba(var(--color-text-primary-rgb), 0.1);
    background: rgba(11, 11, 13, 0.9);
    backdrop-filter: blur(24px);
    overflow: hidden;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.6);
    animation: ns-rise 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .ns-mock-titlebar {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(var(--color-text-primary-rgb), 0.08);
    position: relative;
  }

  .ns-mock-dots {
    display: flex;
    gap: 6px;
  }

  .ns-mock-dots span {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: rgba(var(--color-text-primary-rgb), 0.18);
  }

  .ns-mock-dots span:nth-child(2) {
    background: rgba(var(--color-text-primary-rgb), 0.13);
  }

  .ns-mock-dots span:nth-child(3) {
    background: rgba(var(--color-text-primary-rgb), 0.09);
  }

  .ns-mock-title {
    position: absolute;
    left: 0;
    right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(var(--color-text-primary-rgb), 0.4);
    pointer-events: none;
  }

  .ns-mock-body {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    min-height: 340px;
  }

  .ns-mock-side {
    border-right: 1px solid rgba(var(--color-text-primary-rgb), 0.07);
    padding: 18px 14px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ns-mock-navitem {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 10px;
    color: rgba(var(--color-text-primary-rgb), 0.45);
    font-size: 13px;
  }

  .ns-mock-navitem.is-active {
    background: rgba(var(--color-emerald-rgb), 0.1);
    color: var(--color-emerald);
    font-weight: 500;
  }

  .ns-mock-list {
    border-right: 1px solid rgba(var(--color-text-primary-rgb), 0.07);
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ns-mock-tabs {
    display: none;
    gap: 8px;
    padding: 0 0 4px;
  }

  .ns-mock-tabs span {
    font-size: 12px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(var(--color-text-primary-rgb), 0.04);
    color: rgba(var(--color-text-primary-rgb), 0.45);
    white-space: nowrap;
  }

  .ns-mock-tabs span.is-active {
    background: rgba(var(--color-emerald-rgb), 0.12);
    color: var(--color-emerald);
    font-weight: 500;
  }

  .ns-mock-daylabel {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--color-text-primary-rgb), 0.3);
    padding: 0 4px 6px;
  }

  .ns-mock-rec {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 11px 12px;
    border-radius: 12px;
    background: rgba(var(--color-text-primary-rgb), 0.03);
  }

  .ns-mock-rec-label {
    font-size: 13px;
    color: rgba(var(--color-text-primary-rgb), 0.8);
  }

  .ns-mock-badge {
    font-size: 10px;
    padding: 3px 9px;
    border-radius: 999px;
  }

  .ns-mock-badge--emerald {
    background: rgba(var(--color-emerald-rgb), 0.14);
    color: var(--color-emerald);
  }

  .ns-mock-badge--violet {
    background: rgba(var(--color-violet-rgb), 0.16);
    color: var(--color-violet);
  }

  .ns-mock-badge--neutral {
    background: rgba(var(--color-text-primary-rgb), 0.07);
    color: rgba(var(--color-text-primary-rgb), 0.5);
  }

  .ns-mock-rec-extra {
    display: flex;
  }

  .ns-mock-more {
    display: none;
    padding: 2px 4px 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(var(--color-text-primary-rgb), 0.28);
  }

  .ns-mock-sum {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ns-mock-summary-card {
    border-radius: 16px;
    background: rgba(var(--color-text-primary-rgb), 0.025);
    box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.07);
    padding: 16px;
  }

  .ns-mock-summary-head {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-violet);
  }

  .ns-mock-summary-card p {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(var(--color-text-primary-rgb), 0.6);
  }

  .ns-mock-summary-secondary {
    color: rgba(var(--color-text-primary-rgb), 0.45) !important;
  }

  .ns-mock-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 10px;
    row-gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(var(--color-text-primary-rgb), 0.4);
  }

  .ns-mock-stat--emerald {
    color: var(--color-emerald);
  }

  .ns-mock-bars {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 64px;
  }

  .ns-mock-bar {
    flex: 1;
    border-radius: 4px;
    background: rgba(var(--color-text-primary-rgb), 0.09);
  }

  .ns-mock-bar[data-index='3'] {
    background: rgba(var(--color-emerald-rgb), 0.35);
  }

  .ns-mock-bar[data-index='4'] {
    background: rgba(var(--color-emerald-rgb), 0.55);
  }

  .ns-mock-bar[data-index='5'] {
    background: rgba(var(--color-violet-rgb), 0.35);
  }

  .ns-mock-bar[data-index='6'] {
    background: rgba(var(--color-emerald-rgb), 0.75);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .ns-res-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ns-mock-body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ns-mock-side {
      display: none;
    }

    .ns-mock-tabs {
      display: flex;
    }
  }

  @media (max-width: 767px) {
    .ns-res {
      overflow: clip;
      width: 100%;
      max-width: 100%;
      padding-top: clamp(72px, 18vw, 88px);
      padding-bottom: clamp(72px, 18vw, 88px);
      padding-left: max(24px, env(safe-area-inset-left));
      padding-right: max(24px, env(safe-area-inset-right));
    }

    .ns-res-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
