---
import { team } from '../data/team';
---

<section id="nosotros" class="ns-nos">
  <div class="ns-nos-eyebrow">
    <span class="ns-dot"></span>
    <span class="ns-eyebrow-text">Equipo fundador</span>
  </div>
  <h2 class="ns-nos-title">Conoce al equipo detrás de Newstar Labs.</h2>
  <p class="ns-nos-lead">
    Tres especialidades que se complementan para entender procesos, conectar tecnología y construir soluciones que
    las personas realmente usen.
  </p>

  <div class="ns-nos-grid">
    {
      team.map((member) => (
        <div class="ns-nos-card">
          <div class="ns-nos-avatarwrap">
            <div class="ns-nos-avatarglow" />
            <div class="ns-nos-avatar">
              <img
                src={member.avatar}
                alt={member.avatarAlt}
                width="58"
                height="58"
                loading="lazy"
                decoding="async"
                style={`object-position:${member.avatarPosition}`}
              />
            </div>
          </div>
          <h3 class="ns-nos-name">{member.name}</h3>
          <span class="ns-nos-role">{member.role}</span>
          <span class="ns-nos-specialty">{member.specialty}</span>
          <p class="ns-nos-bio">{member.bio}</p>
          <div class="ns-nos-chips">
            {member.chips.map((chip) => <span>{chip}</span>)}
          </div>
          <div class="ns-nos-foot">
            <span class="ns-nos-badge">
              <span class="ns-nos-badge-dot" />
              Fundador
            </span>
            <a href={member.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn de ${member.name}`} class="ns-nos-linkedin">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.65h.05A4.17 4.17 0 0 1 17.6 8.7c4 0 4.4 2.5 4.4 5.8V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.46-2.2 2.96V21h-4V9Z" />
              </svg>
              <span>LinkedIn</span>
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .ns-nos {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 104px 24px;
    border-top: 1px solid rgba(var(--color-text-primary-rgb), 0.08);
  }

  .ns-nos-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ns-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-emerald);
  }

  .ns-eyebrow-text {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-text-primary-rgb), 0.5);
  }

  .ns-nos-title {
    font-family: var(--font-display);
    font-size: clamp(29px, 4.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 20px 0 0;
    max-width: 30rem;
    text-wrap: pretty;
  }

  .ns-nos-lead {
    margin: 18px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 36rem;
    text-wrap: pretty;
  }

  .ns-nos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 16px;
    margin-top: 48px;
  }

  .ns-nos-card {
    position: relative;
    background: #121114;
    border: 1px solid rgba(70, 64, 78, 0.9);
    border-radius: 8px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color 0.42s ease-out, transform 0.42s ease-out, box-shadow 0.42s ease-out;
  }

  .ns-nos-card::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 40%;
    border-radius: 8px 8px 0 0;
    background: linear-gradient(180deg, rgba(var(--color-text-primary-rgb), 0.05), rgba(var(--color-text-primary-rgb), 0));
    pointer-events: none;
  }

  .ns-nos-card:hover {
    border-color: rgba(var(--color-violet-rgb), 0.5);
    transform: translateY(-3px);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.45);
  }

  .ns-nos-avatarwrap {
    position: relative;
    width: 58px;
    height: 58px;
    flex: none;
  }

  .ns-nos-avatarglow {
    position: absolute;
    inset: -9px;
    border-radius: 999px;
    background: radial-gradient(
      circle at 35% 30%,
      rgba(var(--color-violet-rgb), 0.18),
      rgba(var(--color-emerald-rgb), 0.09) 55%,
      rgba(var(--color-bg-rgb), 0) 75%
    );
    pointer-events: none;
  }

  .ns-nos-avatar {
    position: relative;
    width: 58px;
    height: 58px;
    border-radius: 999px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--color-violet-rgb), 0.1);
    border: 1px solid rgba(var(--color-violet-rgb), 0.3);
  }

  .ns-nos-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ns-nos-name {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .ns-nos-role {
    display: block;
    margin-top: 5px;
    font-size: 13px;
    color: rgba(var(--color-text-primary-rgb), 0.5);
  }

  .ns-nos-specialty {
    display: block;
    margin-top: 8px;
    font-size: 13.5px;
    color: var(--color-violet);
  }

  .ns-nos-bio {
    margin: 14px 0 18px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-secondary);
    text-wrap: pretty;
  }

  .ns-nos-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ns-nos-chips span {
    font-size: 11.5px;
    padding: 5px 11px;
    border-radius: 999px;
    border: 1px solid rgba(var(--color-violet-rgb), 0.28);
    background: rgba(var(--color-violet-rgb), 0.07);
    color: var(--color-violet);
  }

  .ns-nos-foot {
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 44px;
  }

  .ns-nos-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-emerald);
    opacity: 0.85;
  }

  .ns-nos-badge-dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--color-emerald);
  }

  .ns-nos-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    font-size: 12px;
    color: var(--color-text-secondary);
    transition: color 0.35s ease-out;
  }

  .ns-nos-linkedin:hover {
    color: var(--color-violet);
  }
</style>
