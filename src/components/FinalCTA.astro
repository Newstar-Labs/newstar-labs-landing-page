---
import { whatsappHref } from '../data/site';
---

<section class="ns-cta">
  <div class="ns-cta-card">
    <div class="ns-cta-glow" data-pause-offscreen></div>
    <div class="ns-cta-content">
      <h2 class="ns-cta-title">¿Qué proceso podríamos mejorar juntos?</h2>
      <p class="ns-cta-lead">
        Cuéntanos qué le quita tiempo a tu equipo y exploremos una solución creada para tu forma de trabajar.
      </p>
      <div class="ns-cta-btnwrap">
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label="Conversemos por WhatsApp" class="ns-cta-btn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.9-.9L3 21l1.9-5A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"></path>
          </svg>
          <span class="ns-cta-btntext">Conversemos por WhatsApp</span>
          <span class="ns-cta-btnshort">Conversemos</span>
          <span class="ns-cta-arrow">›</span>
        </a>
      </div>
      <p class="ns-cta-note">Respuesta directa por WhatsApp.</p>
    </div>
  </div>
</section>

<style>
  .ns-cta {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 104px 24px 128px;
  }

  .ns-cta-card {
    background: rgba(var(--color-text-primary-rgb), 0.025);
    box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.08);
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    padding: 76px 32px;
    text-align: center;
  }

  .ns-cta-glow {
    position: absolute;
    left: 50%;
    top: 40%;
    transform: translate(-50%, -50%);
    width: 90%;
    height: 120%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(var(--color-emerald-rgb), 0.16),
      rgba(var(--color-violet-rgb), 0.1) 45%,
      rgba(var(--color-bg-rgb), 0) 70%
    );
    animation: ns-breathe 12s ease-in-out infinite;
    will-change: transform, opacity;
    contain: paint;
    pointer-events: none;
  }

  .ns-cta-content {
    position: relative;
  }

  .ns-cta-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 5.4vw, 52px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.07;
    margin: 0;
    color: var(--color-text-primary);
    text-wrap: pretty;
  }

  .ns-cta-lead {
    margin: 22px auto 0;
    color: var(--color-text-secondary);
    font-size: 17px;
    line-height: 1.6;
    max-width: 32rem;
    text-wrap: pretty;
  }

  .ns-cta-btnwrap {
    margin-top: 34px;
    display: flex;
    justify-content: center;
  }

  .ns-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 999px;
    background: var(--color-emerald);
    color: var(--color-bg);
    font-weight: 600;
    font-size: 15px;
    padding: 14px 26px;
    transition: background 0.22s ease-out, transform 0.22s ease-out, box-shadow 0.22s ease-out;
  }

  .ns-cta-btn:hover {
    background: var(--color-emerald-strong);
    color: var(--color-bg);
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(var(--color-emerald-rgb), 0.22);
  }

  .ns-cta-btn:active {
    transform: scale(0.985);
  }

  .ns-cta-btnshort {
    display: none;
  }

  .ns-cta-note {
    margin: 16px 0 0;
    font-size: 12.5px;
    color: rgba(var(--color-text-primary-rgb), 0.42);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .ns-cta {
      padding-top: clamp(24px, 4vw, 40px);
      padding-bottom: clamp(96px, 12vw, 120px);
    }

    .ns-cta-card {
      padding: clamp(64px, 9vw, 76px) 32px;
    }

    .ns-cta-btn {
      min-height: 56px;
      font-size: 17px;
    }
  }

  @media (max-width: 767px) {
    .ns-cta {
      height: auto;
      overflow: clip;
      width: 100%;
      max-width: 100%;
      padding-top: 0;
      padding-bottom: clamp(64px, 17vw, 80px);
      padding-left: max(22px, env(safe-area-inset-left));
      padding-right: max(22px, env(safe-area-inset-right));
    }

    .ns-cta-card {
      width: 100%;
      max-width: 100%;
      height: auto;
      border-radius: 26px;
      padding: clamp(52px, 14vw, 64px) clamp(24px, 6vw, 28px);
    }

    .ns-cta-glow {
      width: 120%;
      height: 70%;
      opacity: 0.7;
    }

    .ns-cta-title {
      font-size: clamp(36px, 9.8vw, 42px);
      line-height: 1.08;
      letter-spacing: -0.032em;
      max-width: 100%;
      margin-inline: auto;
      text-wrap: balance;
    }

    .ns-cta-lead {
      font-size: 17px;
      line-height: 1.55;
      margin-top: 24px;
      max-width: 22rem;
    }

    .ns-cta-btnwrap {
      margin-top: 32px;
    }

    .ns-cta-btn {
      display: grid;
      grid-template-columns: 22px minmax(0, 1fr) 18px;
      gap: 10px;
      align-items: center;
      width: 100%;
      max-width: 420px;
      min-height: 58px;
      padding: 12px 16px;
      font-size: 17px;
    }

    .ns-cta-btntext {
      white-space: nowrap;
    }

    .ns-cta-btn svg {
      width: 20px;
      height: 20px;
      justify-self: center;
    }

    .ns-cta-arrow {
      justify-self: end;
      font-size: 19px;
    }

    .ns-cta-note {
      margin-top: 17px;
      font-size: 14px;
      color: rgba(var(--color-text-primary-rgb), 0.5);
    }
  }

  @media (max-width: 421px) {
    .ns-cta-btntext {
      display: none;
    }

    .ns-cta-btnshort {
      display: inline;
      white-space: nowrap;
    }
  }

  @media (max-width: 340px) {
    .ns-cta-btn {
      font-size: 16px;
    }
  }
</style>
