<style>
  .ns-hero {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 72px 24px 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(460px, 1fr));
    gap: 48px;
    align-items: center;
    min-height: 82vh;
  }

  .ns-hero-copy {
    min-width: 0;
    animation: ns-rise 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .ns-hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }

  .ns-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-emerald);
    box-shadow: 0 0 12px rgba(var(--color-emerald-rgb), 0.8);
  }

  .ns-eyebrow-text {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(var(--color-text-primary-rgb), 0.5);
  }

  .ns-hero-flag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: rgba(var(--color-text-primary-rgb), 0.35);
    border: 1px solid rgba(var(--color-text-primary-rgb), 0.12);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .ns-hero-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 62px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0;
  }

  .ns-hero-title span {
    display: block;
  }

  .ns-hero-shine {
    background-image: linear-gradient(
      to right,
      var(--color-bg) 0%,
      var(--color-emerald-strong) 20%,
      var(--color-emerald) 45%,
      var(--color-violet) 65%,
      var(--color-emerald-strong) 85%,
      var(--color-bg) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    animation: ns-shine 7s linear infinite;
  }

  .ns-hero-p {
    margin: 24px 0 0;
    color: rgba(var(--color-text-primary-rgb), 0.6);
    font-size: 18px;
    line-height: 1.6;
    max-width: 30rem;
    text-wrap: pretty;
  }

  .ns-hero-actions {
    margin-top: 34px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .ns-hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 999px;
    background: var(--color-emerald);
    color: var(--color-bg);
    font-weight: 600;
    font-size: 15px;
    padding: 14px 26px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .ns-hero-cta:hover {
    background: var(--color-emerald-strong);
    color: var(--color-bg);
  }

  .ns-hero-cta:active {
    transform: scale(0.98);
  }

  .ns-hero-hint {
    font-size: 12.5px;
    color: rgba(var(--color-text-primary-rgb), 0.42);
  }

  .ns-hero-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: min(440px, 80vw);
  }

  .ns-hero-glow {
    position: absolute;
    width: 74%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(var(--color-emerald-rgb), 0.2),
      rgba(var(--color-violet-rgb), 0.1) 55%,
      rgba(var(--color-bg-rgb), 0) 72%
    );
    animation: ns-breathe 9s ease-in-out infinite;
    will-change: transform, opacity;
    contain: paint;
  }

  .ns-hero-star {
    max-width: 470px;
    position: relative;
    display: block;
    overflow: visible;
  }

  .ns-hero-orbit {
    transform-origin: 540px 540px;
    animation: ns-spin 90s linear infinite;
    will-change: transform;
  }

  @media (max-width: 1023px) {
    .ns-hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.82fr);
      gap: 32px;
    }

    .ns-hero-star {
      max-width: 340px;
    }
  }

  @media (max-width: 767px) {
    .ns-hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      height: auto;
      padding-top: clamp(72px, 18vw, 88px);
      padding-bottom: clamp(72px, 18vw, 88px);
      padding-left: max(24px, env(safe-area-inset-left));
      padding-right: max(24px, env(safe-area-inset-right));
      gap: 0;
      align-items: start;
    }

    .ns-hero-visual {
      display: none;
    }

    .ns-hero-copy {
      width: 100%;
      max-width: 100%;
    }

    .ns-hero-title {
      font-size: clamp(42px, 12vw, 56px);
      line-height: 1;
    }

    .ns-hero-title span {
      white-space: normal;
    }

    .ns-hero-p {
      font-size: 17px;
      line-height: 1.55;
      margin-top: 30px;
      max-width: 100%;
    }

    .ns-hero-actions {
      margin-top: 36px;
      width: 100%;
    }

    .ns-hero-cta {
      width: 100%;
      max-width: 360px;
      min-height: 56px;
      font-size: 16px;
    }
  }
</style>
