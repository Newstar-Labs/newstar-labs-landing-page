---
import { whatsappHref } from '../data/site';
---

<section id="top" class="ns-hero">
  <div class="ns-hero-copy">
    <div class="ns-hero-eyebrow">
      <span class="ns-dot"></span>
      <span class="ns-eyebrow-text">Socio tecnológico</span>
      <span class="ns-hero-flag">Perú</span>
    </div>
    <h1 class="ns-hero-title">
      <span>Menos fricción, más</span>
      <span class="ns-hero-shine">control</span>
    </h1>
    <p class="ns-hero-p">
      Convertimos procesos manuales y desordenados en operaciones claras y eficientes, para que puedas enfocarte en
      hacer crecer tu negocio.
    </p>
    <div class="ns-hero-actions">
      <a href={whatsappHref} target="_blank" rel="noopener" class="ns-hero-cta">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.9-.9L3 21l1.9-5A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"></path>
        </svg>
        <span>Cuéntanos tu proceso</span>
        <span>›</span>
      </a>
      <span class="ns-hero-hint">Respuesta directa por WhatsApp</span>
    </div>
  </div>

