---
import { industries } from '../data/industries';
---

<section id="industrias" class="ns-sect">
  <h2 class="ns-sect-title">Ideal para negocios que quieren ordenar su operación.</h2>
  <div class="ns-sect-chips">
    {
      industries.map((industry, i) => (
        <span class={i === industries.length - 1 ? 'ns-sect-last' : ''}>{industry}</span>
      ))
    }
  </div>
</section>

<style>
  .ns-sect {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 104px 24px;
    border-top: 1px solid rgba(var(--color-text-primary-rgb), 0.08);
  }

  .ns-sect-title {
    font-family: var(--font-display);
    font-size: clamp(29px, 4.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.12;
    text-align: center;
    max-width: 36rem;
    margin: 0 auto;
    text-wrap: pretty;
  }

  .ns-sect-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 44px;
    max-width: 44rem;
    margin-left: auto;
    margin-right: auto;
  }

  .ns-sect-chips span {
    background: rgba(var(--color-text-primary-rgb), 0.025);
    box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.08);
    position: relative;
    overflow: hidden;
    border-radius: 999px;
    padding: 11px 22px;
    font-size: 14px;
    color: rgba(var(--color-text-primary-rgb), 0.75);
    transition: color 0.4s ease-out, background 0.4s ease-out, box-shadow 0.4s ease-out;
  }

  .ns-sect-chips span:hover {
    color: var(--color-violet);
    background: rgba(var(--color-violet-rgb), 0.09);
    box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.12), 0 0 18px rgba(var(--color-violet-rgb), 0.08);
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .ns-sect {
      padding-top: clamp(96px, 12vw, 120px);
      padding-bottom: clamp(96px, 12vw, 120px);
    }

    .ns-sect-title {
      max-width: 600px;
      text-wrap: balance;
    }

    .ns-sect-chips {
      max-width: 680px;
    }
  }

  @media (max-width: 767px) {
    .ns-sect {
      height: auto;
      overflow: clip;
      width: 100%;
      max-width: 100%;
      padding-top: clamp(72px, 18vw, 88px);
      padding-bottom: clamp(80px, 21vw, 96px);
      padding-left: max(22px, env(safe-area-inset-left));
      padding-right: max(22px, env(safe-area-inset-right));
    }

    .ns-sect-title {
      font-size: clamp(34px, 9.4vw, 42px);
      line-height: 1.1;
      letter-spacing: -0.032em;
      max-width: 560px;
      text-wrap: balance;
    }

    .ns-sect-chips {
      margin-top: 40px;
      gap: 11px;
      max-width: 620px;
    }

    .ns-sect-chips span {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 19px;
      font-size: 15px;
      white-space: nowrap;
      max-width: 100%;
    }

    .ns-sect-chips span:active {
      color: var(--color-violet);
      background: rgba(var(--color-violet-rgb), 0.09);
    }

    .ns-sect-last {
      flex-basis: 100%;
      margin-top: 6px;
      text-align: center;
      white-space: normal !important;
      font-size: 14px !important;
      background: transparent !important;
      box-shadow: inset 0 1px 1px rgba(var(--color-text-primary-rgb), 0.05) !important;
      color: rgba(var(--color-text-primary-rgb), 0.55) !important;
    }
  }
</style>
