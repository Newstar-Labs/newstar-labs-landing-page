---
import { navLinks, whatsappHref } from '../data/site';
---

<nav class="ns-navbar" id="ns-navbar">
  <div class="ns-nav-inner">
    <a href="#top" class="ns-logo">Newstar<span>Labs</span></a>

    <div class="ns-navlinks">
      {
        navLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))
      }
    </div>

    <button
      type="button"
      class="ns-burger"
      id="ns-burger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="ns-mobile-nav"
    >
      <svg class="ns-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16"></path><path d="M4 12h16"></path><path d="M4 17h16"></path>
      </svg>
      <svg class="ns-icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12"></path><path d="M18 6 6 18"></path>
      </svg>
    </button>

    <a href={whatsappHref} target="_blank" rel="noopener" class="ns-navcta">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.9-.9L3 21l1.9-5A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"></path>
      </svg>
      <span>Cuéntanos tu proceso</span>
      <span class="ns-navcta-arrow">›</span>
    </a>
  </div>

  <div class="ns-mobilemenu" id="ns-mobile-nav">
    <div class="ns-mobilemenu-inner">
      {
        navLinks.map((link) => (
          <a href={link.href} class="ns-mobile-link">{link.label}</a>
        ))
      }
      <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="ns-mobile-cta">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.9-.9L3 21l1.9-5A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"></path>
        </svg>
        <span>Cuéntanos tu proceso</span>
      </a>
    </div>
  </div>
</nav>
<div class="ns-scrim" id="ns-scrim" aria-hidden="true"></div>

<script>
  const navbar = document.getElementById('ns-navbar');
  const burger = document.getElementById('ns-burger');
  const mobileMenu = document.getElementById('ns-mobile-nav');
  const scrim = document.getElementById('ns-scrim');

  if (navbar && burger && mobileMenu && scrim) {
    const setOpen = (open: boolean) => {
      navbar.classList.toggle('is-open', open);
      scrim.classList.toggle('is-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.body.style.overflow = open ? 'hidden' : '';
    };

    burger.addEventListener('click', () => {
      setOpen(!navbar.classList.contains('is-open'));
    });

    scrim.addEventListener('click', () => setOpen(false));

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && navbar.classList.contains('is-open')) {
        setOpen(false);
      }
    });

    window.addEventListener(
      'resize',
      () => {
        if (window.innerWidth > 900 && navbar.classList.contains('is-open')) {
          setOpen(false);
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  .ns-navbar {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(14px);
    background: rgba(var(--color-bg-rgb), 0.65);
    border-bottom: 1px solid rgba(var(--color-text-primary-rgb), 0.06);
    animation: ns-fade 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .ns-nav-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .ns-logo {
    display: flex;
    align-items: center;
    color: var(--color-text-primary);
    flex: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    letter-spacing: -0.02em;
  }

  .ns-logo span {
    font-weight: 400;
    color: rgba(var(--color-text-primary-rgb), 0.85);
    margin-left: 6px;
  }

  .ns-navlinks {
    display: flex;
    align-items: center;
    gap: 32px;
    flex: 1;
    justify-content: center;
  }

  .ns-navlinks a {
    color: rgba(var(--color-text-primary-rgb), 0.7);
    font-size: 14px;
    transition: color 0.2s ease-out;
  }

  .ns-navlinks a:hover {
    color: var(--color-text-primary);
  }

  .ns-burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 999px;
    border: 1px solid rgba(var(--color-text-primary-rgb), 0.12);
    background: rgba(var(--color-text-primary-rgb), 0.06);
    backdrop-filter: blur(10px);
    color: var(--color-text-primary);
    cursor: pointer;
    transition: border-color 0.3s ease-out, background 0.3s ease-out;
  }

  .ns-burger:hover {
    border-color: rgba(var(--color-emerald-rgb), 0.4);
    background: rgba(var(--color-emerald-rgb), 0.08);
  }

  .ns-icon-close {
    display: none;
  }

  .ns-burger[aria-expanded='true'] .ns-icon-open {
    display: none;
  }

  .ns-burger[aria-expanded='true'] .ns-icon-close {
    display: block;
  }

  .ns-navcta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 999px;
    background: var(--color-emerald);
    color: var(--color-bg);
    font-weight: 600;
    font-size: 14px;
    padding: 11px 22px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .ns-navcta:hover {
    background: var(--color-emerald-strong);
    color: var(--color-bg);
  }

  .ns-navcta:active {
    transform: scale(0.98);
  }

  .ns-mobilemenu {
    display: none;
  }

  .ns-navbar.is-open .ns-mobilemenu {
    display: block;
    border-top: 1px solid rgba(var(--color-text-primary-rgb), 0.08);
    background: rgba(var(--color-bg-rgb), 0.96);
    backdrop-filter: blur(14px);
    animation: ns-fade 0.28s ease-out both;
  }

  .ns-mobilemenu-inner {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 14px max(20px, env(safe-area-inset-left)) 22px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ns-mobile-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 4px;
    font-size: 16px;
    color: var(--color-text-primary);
    border-bottom: 1px solid rgba(var(--color-text-primary-rgb), 0.06);
    transition: color 0.2s ease-out;
  }

  .ns-mobile-link:hover {
    color: var(--color-emerald);
  }

  .ns-mobile-cta {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    border-radius: 999px;
    background: var(--color-emerald);
    color: var(--color-bg);
    font-weight: 600;
    font-size: 15px;
    transition: background 0.2s ease;
  }

  .ns-mobile-cta:hover {
    background: var(--color-emerald-strong);
    color: var(--color-bg);
  }

  .ns-scrim {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 30;
    background: rgba(var(--color-bg-rgb), 0.5);
  }

  .ns-scrim.is-open {
    display: block;
  }

  @media (max-width: 900px) {
    .ns-navlinks {
      display: none;
    }

    .ns-burger {
      display: inline-flex;
    }
  }

  @media (max-width: 767px) {
    .ns-navcta {
      display: none;
    }

    .ns-nav-inner {
      padding-top: 10px;
      padding-bottom: 10px;
      gap: 12px;
      padding-left: max(24px, env(safe-area-inset-left));
      padding-right: max(24px, env(safe-area-inset-right));
    }
  }

  @media (max-width: 560px) {
    .ns-navcta {
      padding: 11px 14px;
    }
  }
</style>
