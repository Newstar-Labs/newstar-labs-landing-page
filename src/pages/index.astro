---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StatusTicker from '../components/StatusTicker.astro';
import ProblemSection from '../components/ProblemSection.astro';
import SolutionsSection from '../components/SolutionsSection.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import ProjectsCarousel from '../components/ProjectsCarousel.astro';
import IndustriesSection from '../components/IndustriesSection.astro';
import DifferenceAccordion from '../components/DifferenceAccordion.astro';
import TeamSection from '../components/TeamSection.astro';
import AgendaSesion from '../components/AgendaSesion.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <header>
    <Navbar />
  </header>
  <main>
    <Hero />
    <StatusTicker />
    <ProblemSection />
    <SolutionsSection />
    <ProcessTimeline />
    <ProjectsCarousel />
    <IndustriesSection />
    <DifferenceAccordion />
    <TeamSection />
    <AgendaSesion />
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: var(--nav-height, 70px);
  }
</style>
